{
  "name": "tiny-bilibili-ws",
  "type": "module",
  "version": "1.0.3",
  "packageManager": "pnpm@11.8.0",
  "description": "Bilibili Live WebSocket/TCP API",
  "author": "starknt",
  "license": "MIT",
  "homepage": "https://github.com/starknt/tiny-bilibili-ws#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/starknt/tiny-bilibili-ws.git"
  },
  "bugs": "https://github.com/starknt/tiny-bilibili-ws/issues",
  "keywords": [
    "ws",
    "websocket",
    "bilibili",
    "live"
  ],
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "browser.d.ts",
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "PUBLISH=true pnpm run build",
    "release": "npx bumpp --no-push && pnpm publish",
    "dev": "tsdown --watch",
    "docs:dev": "pnpm -C docs run docs:dev",
    "docs:build": "pnpm -C docs run docs:build",
    "docs:preview": "pnpm -C docs run docs:preview",
    "test": "vitest",
    "bench": "vitest bench",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "size": "pnpm run build && tsx --tsconfig=./tsconfig.tsx.json ./scripts/size.ts"
  },
  "dependencies": {
    "eventemitter3": "^5.0.4",
    "pako": "^2.2.0",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@types/node": "^26.0.0",
    "@types/pako": "^2.0.4",
    "@types/ws": "^8.18.1",
    "brotli-size": "^4.0.0",
    "bumpp": "^11.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.5.0",
    "gzip-size": "^7.0.0",
    "pnpm": "^11.8.0",
    "terser": "^5.48.0",
    "tsdown": "^0.22.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^2.1.9"
  }
}
